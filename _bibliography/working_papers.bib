@unpublished{jiang2026colorofactivityspace,
  abbr={Under review},
  title={The Color of Activity Space: Redlining and the Racial Segregation of Everyday Places},
  author={Wenhao Jiang and Yongjun Zhang},
  abstract={Racial segregation is conventionally located where people sleep, yet groups meet or miss one another in the places they pass through by day: the stores, clinics, churches, and restaurants that make up their activity spaces. We argue that this segregation in activity spaces is not merely a shadow of residential sorting but a lasting imprint of exclusionary institutions that organized American space by race, and trace it to a paradigmatic case: 1930s "redlining," in which federal appraisers graded neighborhoods in a color-coded hierarchy of mortgage risk steeped in racial assumptions. Using the inferred racial composition of visitors to four million establishments, we compare locations across historical redlining boundaries with undrawn counterfactual boundaries dividing neighborhoods with similar preexisting differences. Nearly a century later, lower-graded neighborhoods host activity spaces more racially segregated from their metros, and redlining explains about 6% of the standard deviation of place-level segregation at these borders. The effect works mainly through neighborhood racial composition: redlining left neighborhoods more Black and less white than their metros today, and visitors—even those from elsewhere—mirror that skew, suggesting racialized preferences over destination choices. A bureaucratic classification long abandoned still organizes whom Americans encounter each day.},
  pdf={Jiang Color of Activity Space.pdf},
  code={https://github.com/wenhaojiangsoc/RedSeg},
  year={2026}
}

@unpublished{jiang2026geographicaffinity,
  abbr={Under review},
  title={The Growing Geographic Affinity Between High- and Low-Paying Occupations},
  author={Wenhao Jiang and Siwei Cheng},
  abstract={Research on the geography of work has largely emphasized the spatial concentration of occupations with similar wage levels and the divergence of economic opportunity across regions. Using a novel occupation–location embedding approach that captures the latent spatial co-occurrence structure of occupations across the wage spectrum, we shift the focus and show that occupations at opposite ends of the wage distribution—high-paying professional and managerial occupations and low-paying personal care and service occupations—are increasingly co-located within the same or structurally similar labor markets, despite their stark differences in pay, skill, and social status. This rising geographic affinity is concentrated in dense, immigrant-rich labor markets and is driven largely by high-earning professions with long working hours, especially for women, and by personal service work built on physical proximity, care, and face-to-face contact. Drawing on evidence that local growth in professional and managerial employment precedes the convergence, we argue that the growing affinity reflects rising demand from time-constrained professional households pulling care work toward the places where professionals are concentrated. Within these shared labor markets, however, the two groups remain separated across residential neighborhoods, with no sign of desegregation over time. These findings reveal a new spatial dimension of labor market polarization and its implications for socioeconomic bifurcation and inequality within shared economic regions.},
  pdf={Jiang Cheng Geographic Affinity.pdf},
  year={2026}
}
